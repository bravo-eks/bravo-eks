NODE_ENV=development

API_GATEWAY_PORT=8080

# PostgreSQL
POSTGRES_DB=bravo
POSTGRES_USER=bravo
POSTGRES_PASSWORD=change-me

POSTGRES_MULTIPLE_DATABASES=order_db,inventory_db,payment_db,shipping_db,notification_db

ORDER_DATABASE_URL=postgres://bravo:change-me@postgres:5432/order_db?sslmode=disable
INVENTORY_DATABASE_URL=postgres://bravo:change-me@postgres:5432/inventory_db?sslmode=disable
PAYMENT_DATABASE_URL=postgres://bravo:change-me@postgres:5432/payment_db?sslmode=disable
SHIPPING_DATABASE_URL=postgres://bravo:change-me@postgres:5432/shipping_db?sslmode=disable
NOTIFICATION_DATABASE_URL=postgres://bravo:change-me@postgres:5432/notification_db?sslmode=disable

# Dashboard currently reads directly from the database
DASHBOARD_DATABASE_URL=postgres://bravo:change-me@postgres:5432/order_db?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# LocalStack / AWS SQS
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_QUEUE_URL=http://localstack:4566/000000000000/bravo-queue

# API Gateway
JWT_SECRET=change-me